# 프론트 환경변수. 값을 채워 .env 로 복사한다. .env 는 커밋되지 않는다.

# 실서버 주소. 목만 쓰는 동안에는 안 봐도 된다
VITE_API_BASE=/api/v1

# 실서버로 보낼 엔드포인트. BE 가 붙는 대로 쉼표로 하나씩 늘린다.
# 여기 없는 것은 전부 목으로 돈다.
#   예) VITE_REAL_API=

# 담당자 식별자(X-Operator-Id). 인증이 아니라 감사 기록용이다 — 명세 v10 규약 2항
VITE_OPERATOR_ID=demoGET /suppliers,GET /suppliers/{id},POST /suppliers
VITE_REAL_API=

# 담당자 식별자(X-Operator-Id). 인증이 아니라 감사 기록용이다 — 명세 v10 규약 2항
VITE_OPERATOR_ID=demo
