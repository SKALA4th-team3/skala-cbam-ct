# 프론트 환경변수. 값을 채워 .env 로 복사한다. .env 는 커밋되지 않는다.

# 실서버 주소. 목만 쓰는 동안에는 안 봐도 된다.
# /api/v1 로 두면 vite 개발 서버가 아래 VITE_BACKEND_ORIGIN 으로 넘겨준다(같은 오리진이라 CORS 없음)
VITE_API_BASE=/api/v1

# 백엔드를 다른 포트로 띄웠으면 여기만 바꾼다. 비우면 http://localhost:8081
VITE_BACKEND_ORIGIN=http://localhost:8080

# 실서버로 보낼 엔드포인트. BE 가 붙는 대로 쉼표로 하나씩 늘린다.
# 여기 없는 것은 전부 목으로 돈다. `npm run api:status` 로 현황을 본다.
#
# ── 시연용 한 줄 ──────────────────────────────────────────────
# 백엔드를 `SPRING_PROFILES_ACTIVE=dev,mock` 으로 띄운 뒤 아래 주석을 벗기면
# 기준정보 · 완제품 · 검토 · 확정 · 반려가 전부 실서버로 간다.
# 붙인 뒤에는 `npm run api:demo` 로 시연 경로가 실제로 도는지 확인한다.
#VITE_REAL_API=GET /suppliers,GET /suppliers/{supplierId},POST /suppliers,GET /parts,GET /parts/{partId},GET /products,GET /products/{productId},GET /submissions,POST /submissions/{submissionId}/confirm,POST /submissions/{submissionId}/reject
VITE_REAL_API=

# 담당자 식별자(X-Operator-Id). 인증이 아니라 감사 기록용이다 — 명세 v10 규약 2항
# ⚠️ HTTP 헤더라 ASCII 만 담긴다. 한글 이름을 넣으면 요청 자체가 나가지 않는다
VITE_OPERATOR_ID=demo-reviewer
