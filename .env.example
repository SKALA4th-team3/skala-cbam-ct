# ═════════════════════════════════════════════════════════════
#  skala-cbam-ct — 환경변수 예시
#
#  이 파일을 .env 로 복사한다.   cp .env.example .env
#  .env 는 .gitignore 에 있다. 실제 값을 이 파일에 적지 않는다.
#
#  ⚠️ 쓰는 것만 주석(#)을 벗기고 값을 채운다.
#     주석을 벗긴 채 값을 비워 두면 안 된다 — 스프링은
#     ${DB_URL:기본값} 에서 변수가 "빈 문자열로 존재"하면 기본값을
#     쓰지 않고 빈 문자열을 쓴다. 부팅이 깨진다.
#
#  ⚠️ 스프링은 .env 를 저절로 읽지 않는다. 셸에 올려야 한다:
#         set -a; source .env; set +a
#     또는 IDE 실행 구성의 환경변수 파일 기능을 쓴다.
#     backend/src/main/resources/application.yml 과 프로필별 YAML 이 이 이름들을 참조한다.
#
#  ⚠️ 협력업체 담당자 이메일은 개인정보다.
#     실제 주소를 예시 값으로 넣지 않는다.
# ═════════════════════════════════════════════════════════════

# ─── 메일 수신 (18번 수신 메일 감지) ─────────────────────────
# 지정 메일함을 주기적으로 조회한다. IMAP / API 중 무엇으로 할지는
# 아직 안 정했다 — 정하면 docs/decisions/ 에 ADR 을 남긴다
#MAIL_INBOX_HOST=
#MAIL_INBOX_PORT=
#MAIL_INBOX_USERNAME=
#MAIL_INBOX_PASSWORD=

# ─── 메일 발송 (17번 리마인드 · 50번 피드백 발송) ────────────
#MAIL_SMTP_HOST=
#MAIL_SMTP_PORT=587
#MAIL_SMTP_USERNAME=
#MAIL_SMTP_PASSWORD=

# ─── AI 서비스 (23번 항목 추출 · 42번 초안 생성) ─────────────
# 어느 제공자를 쓸지 아직 안 정했다 — 정하면 ADR 을 남긴다
#AI_BASE_URL=
#AI_API_KEY=
#AI_MODEL=

# ─── DB ──────────────────────────────────────────────────────
# dev 프로필은 부팅용 H2 인메모리를 쓴다 (ADR-0003).
# prod 프로필은 아래 세 값을 모두 채운 PostgreSQL을 쓴다.
# 로컬 PostgreSQL은 `docker compose up -d`로 띄운다.
# POSTGRES_DB를 비우면 Docker Compose가 `cbam`을 사용한다.
#POSTGRES_DB=cbam
#DB_URL=
#DB_USERNAME=
#DB_PASSWORD=
