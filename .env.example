# ═════════════════════════════════════════════════════════════
#  skala-cbam-ct — 환경변수 예시
#
#  이 파일을 .env 로 복사해 값을 채운다.  cp .env.example .env
#  .env 는 .gitignore 에 있다. 실제 값을 이 파일에 적지 않는다.
#
#  ⚠️ 협력업체 담당자 이메일은 개인정보다.
#     실제 주소를 예시 값으로 넣지 않는다.
# ═════════════════════════════════════════════════════════════

# ─── 메일 수신 (18번 수신 메일 감지) ─────────────────────────
# 지정 메일함을 주기적으로 조회한다. IMAP / API 중 무엇으로 할지는
# 아직 안 정했다 — 정하면 docs/decisions/ 에 ADR 을 남긴다
MAIL_INBOX_HOST=
MAIL_INBOX_PORT=
MAIL_INBOX_USERNAME=
MAIL_INBOX_PASSWORD=

# ─── 메일 발송 (17번 리마인드 · 50번 피드백 발송) ────────────
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# ─── AI 서비스 (23번 항목 추출 · 42번 초안 생성) ─────────────
# 어느 제공자를 쓸지 아직 안 정했다 — 정하면 ADR 을 남긴다
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ─── DB ──────────────────────────────────────────────────────
# DB 종류가 아직 안 정해졌다 — 정하면 ADR 을 남긴다
DB_URL=
DB_USERNAME=
DB_PASSWORD=
